PORT=5000
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Server wallet that signs on-chain transactions (use a dedicated test key)
PRIVATE_KEY=your_wallet_private_key_here
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Google AI Studio key for the AI impact report / compliance feature
GEMINI_API_KEY=your_gemini_api_key_here
# Secret used to sign JWT session tokens for trustee auth (random 32+ char string)
JWT_SECRET=your_jwt_secret_here
# Secret used to AES-256-GCM encrypt trustee private keys (random 32+ char string)
TRUSTEE_ENCRYPTION_SECRET=your_encryption_secret_here
# Contract deployer / owner address — only this wallet can access the admin panel
OWNER_ADDRESS=your_contract_owner_address_here
